---
import '../styles/global.css';
import { meta } from '../lib/data';
import { dataHoraBR } from '../lib/format';
import { href } from '../lib/url';

interface Props { title: string; description?: string; active?: string }
const { title, description = 'Painel aberto dos gastos da Cota Parlamentar (CEAP) dos deputados federais, com dados oficiais da Câmara dos Deputados.', active = '' } = Astro.props;
const m = meta();
const nav = [
  ['inicio', '', 'Início'],
  ['ranking', 'ranking/', 'Ranking'],
  ['fornecedores', 'fornecedores/', 'Fornecedores'],
  ['fora-da-curva', 'pontos-fora-da-curva/', 'Pontos fora da curva'],
  ['metodologia', 'metodologia/', 'Metodologia'],
];
const pageTitle = title === 'Gastômetro' ? 'Gastômetro · Cota parlamentar em dados' : `${title} · Gastômetro`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem('gastometro-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href()} aria-label="Gastômetro, página inicial">
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--accent)"/><path d="M7 22a9 9 0 0 1 18 0" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/><path d="M16 22l5-7" stroke="#ffd166" stroke-width="2.5" stroke-linecap="round"/><circle cx="16" cy="22" r="2" fill="#fff"/></svg>
          <span>Gastômetro</span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {nav.map(([key, path, label]) => (
              <li><a href={href(path)} aria-current={active === key ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Alternar tema claro/escuro" title="Alternar tema">
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>Fonte:</strong> <a href={m.fonte.url} rel="noopener">Câmara dos Deputados — Dados Abertos da Cota Parlamentar</a>.
          Dados processados em {dataHoraBR(m.gerado_em)}. Período: {m.periodo.inicio} a {m.periodo.fim} ({m.legislatura}ª legislatura).
        </p>
        <p class="muted small">
          Os dados são oficiais e apresentados como publicados. Valores estatisticamente atípicos não indicam irregularidade.
          Para cada despesa, a referência é o documento original publicado pela Câmara.
          Projeto independente, sem vínculo com a Câmara dos Deputados. Código sob licença MIT.
        </p>
      </div>
    </footer>
    <script>
      const btn = document.querySelector('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme
          ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('gastometro-theme', next); } catch (e) {}
        window.dispatchEvent(new CustomEvent('themechange'));
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 16px; min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.1rem; color: var(--text); text-decoration: none; flex-shrink: 0; }
  nav { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  nav a { display: block; padding: 7px 11px; border-radius: 8px; color: var(--text-2); text-decoration: none; font-size: .92rem; white-space: nowrap; }
  nav a:hover { background: var(--surface-2); color: var(--text); }
  nav a[aria-current="page"] { color: var(--text); background: var(--surface-2); font-weight: 600; }
  .theme-toggle { flex-shrink: 0; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); color: var(--text-2); cursor: pointer; display: grid; place-items: center; }
  .theme-toggle .moon { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle .sun { display: none; }
    :global(:root:not([data-theme="light"])) .theme-toggle .moon { display: block; }
  }
  @media (max-width: 719px) {
    .bar { flex-wrap: wrap; gap: 6px 12px; padding-top: 8px; }
    nav { order: 3; flex-basis: 100%; margin: 0 -6px 6px; }
    .theme-toggle { margin-left: auto; }
  }
  .site-footer { border-top: 1px solid var(--border); margin-top: 48px; padding: 28px 0 40px; color: var(--text-2); font-size: .9rem; }
</style>
